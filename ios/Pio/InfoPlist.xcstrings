    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pío hört nur zu, wenn du auf Sprechen tippst, um zu übersetzen, was du sagst, und dir bei der Aussprache zu helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pío listens only when you tap Speak, to translate what you say and help you pronounce it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pío te escucha solo cuando tocas Hablar, para traducir lo que dices y ayudarte a pronunciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pío t'écoute seulement quand tu touches Parler, pour traduire ce que tu dis et t'aider à le prononcer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pío ti ascolta solo quando tocchi Parla, per tradurre quello che dici e aiutarti a pronunciarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pío escuta só quando você toca em Falar, para traduzir o que você diz e ajudar na pronúncia."
          }
        }
      }
    }
  },
  "version": "1.0"
}
