    "offline.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüf dein Internet und versuch es noch einmal. Deine Sprachen sind noch gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your internet and try again. Your languages are still saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu internet y vuelve a intentar. Tus idiomas siguen guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ton internet et réessaie. Tes langues sont toujours enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla internet e riprova. Le tue lingue sono ancora salvate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a internet e tente de novo. Os seus idiomas continuam guardados."
          }
        }
      }
    },
    "offline.retry": {
