    },
    "offline.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann mich nicht verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't connect"
          }
        },
        "es": {
          "stringUnit": {
