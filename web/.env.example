# Server only. Never add NEXT_PUBLIC_ or commit populated files.
OPENAI_API_KEY=
PIO_TEXT_MODEL=gpt-5.4-mini-2026-03-17
ELEVENLABS_API_KEY=
PIO_VOICE_MODEL=eleven_v4
# Speech recognition and clarity grading (ElevenLabs Scribe).
PIO_STT_MODEL=scribe_v3
# Optional upgrade to phoneme-level assessment. Leave empty to grade clarity with Scribe.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Select and audition native voices in the ElevenLabs account for each enabled locale.
# Optional: another ElevenLabs voice id for Pío. The default is in lib/services.ts.
PIO_VOICE=
# Required in production. Use a strong random code for the private pilot.
# Opcional: si se define, Pío pide este código para entrar.
PIO_ACCESS_CODE=
